DATABASE_URL='postgresql://localhost/headspace'
# NEON_DATABASE_URL='postgresql://user:password@host/database?sslmode=require&channel_binding=require'
DATABASE_POOL_MIN_SIZE='1'
DATABASE_POOL_MAX_SIZE='5'
GROQ_API_KEY='gsk_...'
# Sampling temperature for ingest extraction and enrichment (0-2); defaults to 0.5.
# GROQ_TEMPERATURE='0.5'
MEMORY_S3_BUCKET='headspace-sources'
MEMORY_S3_REGION='us-east-1'
# MEMORY_S3_ENDPOINT_URL='https://<account>.r2.cloudflarestorage.com'
AWS_ACCESS_KEY_ID=''
AWS_SECRET_ACCESS_KEY=''
API_CORS_ORIGINS='http://localhost:5173'
# Generate a persistent RSA keypair; never commit the private key.
# In deployment, set AUTH_JWT_PRIVATE_KEY / AUTH_JWT_PUBLIC_KEY to the PEM contents instead.
AUTH_JWT_PRIVATE_KEY_FILE='.secrets/auth-jwt-private.pem'
AUTH_JWT_PUBLIC_KEY_FILE='.secrets/auth-jwt-public.pem'
AUTH_JWT_ISSUER='headspace-api'
AUTH_JWT_AUDIENCE='headspace-app'
AUTH_SESSION_TTL_HOURS='24'
REDIS_URL='redis://localhost:6379/0'
RQ_QUEUE_NAME='default'
OLLAMA_BASE_URL='http://127.0.0.1:11434'
EMBEDDING_MODEL='nomic-embed-text'
EMBEDDING_DIMENSIONS='768'
EMBEDDING_DOCUMENT_PREFIX='search_document: '
EMBEDDING_QUERY_PREFIX='search_query: '
